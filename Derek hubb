--==================== UTILIDADES =========================
local function getRemote(name)
	local folder = RS:FindFirstChild("Remotes")
	if folder then
		local ev = folder:FindFirstChild(name)
		if ev and ev:IsA("RemoteEvent") then return ev end
	end
	for _, d in ipairs(RS:GetDescendants()) do
		if d:IsA("RemoteEvent") and string.find(string.lower(d.Name), string.lower(name), 1, true) then
			return d
		end
	end
	return nil
end

local ShootEv = getRemote("ShootGun")
local KnifeEv = getRemote("KnifeHit")
local ThrowEv = getRemote("ThrowKnife")

local function alive(p)
	local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	return h ~= nil and h.Health > 0
end

local function role(p)
	local c = p.Character
	if not c then return "None" end
	local bp = p:FindFirstChild("Backpack")
	if c:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife")) then return "Murderer" end
	if c:FindFirstChild("Gun")   or (bp and bp:FindFirstChild("Gun"))   then return "Sheriff"  end
	return "Innocent"
end

local function inFov(p, radius)
	if p == LP or not alive(p) then return false end
	local head = p.Character:FindFirstChild("Head")
	if not head then return false end
	local sp, onScreen = Cam:WorldToViewportPoint(head.Position)
	if not onScreen then return false end
	return (Vector2.new(sp.X, sp.Y) - Cam.ViewportSize / 2).Magnitude <= radius
end

local function nearest(radius, filter)
	local best, bestDist
	for _, p in ipairs(Players:GetPlayers()) do
		if filter(p) and inFov(p, radius) then
			local d = (p.Character.Head.Position - Cam.CFrame.Position).Magnitude
			if not bestDist or d < bestDist then best, bestDist = p, d end
		end
	end
	return best
end

local function getTool(n)
	local c = LP.Character
	return (c and c:FindFirstChild(n)) or LP:FindFirstChild("Backpack") and LP.Backpack:FindFirstChild(n)
end

local function equip(n)
	local t = getTool(n)
	if t and LP.Character and t.Parent ~= LP.Character then
		pcall(function() LP.Character.Humanoid:EquipTool(t) end)
	end
	return t
end

local function notify(txt)
	pcall(function()
		local gui = Instance.new("ScreenGui")
		gui.ResetOnSpawn = false
		gui.Parent = CoreGui or LP:WaitForChild("PlayerGui")
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(0, 250, 0, 34)
		l.Position = UDim2.new(0.5, -125, 0.85, 0)
		l.BackgroundColor3 = Color3.fromRGB(120, 60, 200)
		l.TextColor3 = Color3.new(1, 1, 1)
		l.Font = Enum.Font.GothamBold
		l.TextSize = 14
		l.Text = txt
		l.Parent = gui
		task.delay(2, function() gui:Destroy() end)
	end)
end

