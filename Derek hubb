local function fovRow(parent, key)
	local f = new("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Parent = parent }, parent)
	local lbl = new("TextLabel", {
		Size = UDim2.new(0.5, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "FOV: " .. cfg[key],
		TextColor3 = Color3.fromRGB(200, 200, 210),
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		Parent = f,
	}, f)
	local function mk(txt, pos, delta)
		local b = new("TextButton", {
			Size = UDim2.new(0.25, -3, 1, 0),
			Position = UDim2.new(pos, 0, 0, 0),
			BackgroundColor3 = Color3.fromRGB(40, 40, 50),
			Text = txt,
			TextColor3 = Color3.new(1, 1, 1),
			Font = Enum.Font.GothamBold,
			TextSize = 14,
			BorderSizePixel = 0,
			Parent = f,
		}, f)
		new("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
		b.MouseButton1Click:Connect(function()
			cfg[key] = math.clamp(cfg[key] + delta, 60, 800)
			lbl.Text = "FOV: " .. cfg[key]
		end)
	end
	mk("-", 0.5, -20)
	mk("+", 0.75, 20)
end

