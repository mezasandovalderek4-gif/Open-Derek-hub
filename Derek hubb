--==================== HITBOX =============================
local origSizes = {}

local function applyHitbox()
	for _, p in ipairs(Players:GetPlayers()) do
		local head = p.Character and p.Character:FindFirstChild("Head")
		if head then
			if not origSizes[p] then origSizes[p] = head.Size end
			head.Size = Vector3.new(8, 8, 8)
		end
	end
end

local function clearHitbox()
	for p, s in pairs(origSizes) do
		local head = p.Character and p.Character:FindFirstChild("Head")
		if head then head.Size = s end
	end
	origSizes = {}
end

--==================== ESP ================================
local espObjs = {}

local function clearEspFor(p)
	local list = espObjs[p]
	if not list then return end
	for _, o in ipairs(list) do pcall(function() o:Destroy() end) end
	espObjs[p] = nil
end

local function clearEsp()
	for p in pairs(espObjs) do clearEspFor(p) end
end

local function colorFor(r)
	if r == "Murderer" then return Color3.fromRGB(255, 60, 60) end
	if r == "Sheriff"  then return Color3.fromRGB(60, 140, 255) end
	return Color3.fromRGB(80, 255, 130)
end

local function buildEsp(p)
	local c = p.Character
	local head = c and c:FindFirstChild("Head")
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if not head or not hum or hum.Health <= 0 then return end
	local r = role(p)
	local col = colorFor(r)
	local objs = {}

	local hl = Instance.new("Highlight")
	hl.Adornee = c
	hl.FillColor = col
	hl.FillTransparency = 0.65
	hl.OutlineColor = col
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = c
	table.insert(objs, hl)

	local bb = Instance.new("BillboardGui")
	bb.Adornee = head
	bb.Size = UDim2.fromOffset(130, 28)
	bb.StudsOffset = Vector3.new(0, 1.7, 0)
	bb.AlwaysOnTop = true
	bb.Parent = head
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.Text = r .. " | " .. p.Name
	lbl.TextColor3 = col
	lbl.TextScaled = true
	lbl.Font = Enum.Font.GothamBold
	lbl.TextStrokeTransparency = 0
	lbl.Parent = bb
	table.insert(objs, bb)

	if cfg.hitbox then
		local box = Instance.new("BoxHandleAdornment")
		box.Adornee = head
		box.Size = Vector3.new(8, 8, 8)
		box.Color3 = col
		box.Transparency = 0.75
		box.AlwaysOnTop = true
		box.ZIndex = 5
		box.Parent = head
		table.insert(objs, box)
	end

	espObjs[p] = objs
end

--==================== AUTO SHOOT =========================
task.spawn(function()
	while task.wait(0.06) do
		if cfg.autoShoot and ShootEv then
			local target = nearest(cfg.gunFov, function(p) return role(p) == "Murderer" end)
			if target then
				local gun = getTool("Gun")
				pcall(function() ShootEv:FireServer(target.Character.Head.Position, gun) end)
			end
		end
	end
end)

--==================== KILL ALL ===========================
local function killAll()
	if not KnifeEv then notify("No se encontro el remote de cuchillo") return end
	equip("Knife")
	for pass = 1, 2 do
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LP and alive(p) and role(p) ~= "Murderer" then
				local head = p.Character:FindFirstChild("Head")
				if head then pcall(function() KnifeEv:FireServer(head) end) end
			end
		end
		task.wait(0.12)
	end
end

--==================== CUCHILLO SIN CD / AIM ==============
task.spawn(function()
	while task.wait(0.16) do
		if cfg.knifeSpam and ThrowEv then
			if getTool("Knife") then
				local target = nearest(cfg.knifeFov, function(p)
					local r = role(p)
					return r == "Innocent" or r == "Sheriff"
				end)
				local aim = target and target.Character.Head.Position or nil
				pcall(function() ThrowEv:FireServer(aim) end)
			end
		end
	end
end)

local function knifeAimStep()
	local target = nearest(cfg.knifeFov, function(p)
		local r = role(p)
		return r == "Innocent" or r == "Sheriff"
	end)
	if target and target.Character.Head then
		Cam.CFrame = CFrame.lookAt(Cam.CFrame.Position, target.Character.Head.Position)
	end
end

--==================== AUTO FARM ==========================
task.spawn(function()
	while task.wait(0.35) do
		if cfg.autoFarm then
			local char = LP.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				for _, d in ipairs(workspace:GetDescendants()) do
					if d:IsA("BasePart") then
						local n = string.lower(d.Name)
						if string.find(n, "coin", 1, true) or string.find(n, "gem", 1, true)
							or string.find(n, "snowflake", 1, true) or string.find(n, "candy", 1, true) then
							pcall(function()
								firetouchinterest(hrp, d, 0)
								firetouchinterest(hrp, d, 1)
							end)
						end
					end
				end
			end
			if role(LP) == "Murderer" and KnifeEv then killAll() end
		end
	end
end)

